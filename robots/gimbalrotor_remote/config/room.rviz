Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: gimbalrotor_remote/ArmControlPanel
    Name: ArmControlPanel
    Robot Namespace: gimbalrotor
    Arm Controller Namespace: arm/arm_controller
    Torque Service Namespace: arm_torque
  - Class: gimbalrotor_remote/FlightTeleopPanel
    Name: FlightTeleopPanel
    Robot Namespace: gimbalrotor
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
      Reference Frame: <Fixed Frame>
    # the map of room_localization; it also takes the pose of the 2D Pose Estimate tool
    - Class: rviz/PointCloud2
      Name: RoomMap
      Enabled: true
      Topic: /room_localization/map_cloud
      Style: Points
      Size (Pixels): 2
      Decay Time: 0
      Color Transformer: AxisColor
      Axis: Z
      Alpha: 0.5
      Queue Size: 2
    - Class: rviz/RobotModel
      Name: RobotModel
      Enabled: true
      Robot Description: /gimbalrotor/robot_description
      TF Prefix: gimbalrotor
      Visual Enabled: true
      Collision Enabled: false
    # the fast_lio cloud, thinned on the robot (lio_cloud_rate of bringup, 2 Hz) and sent only while this
    # display is enabled; it lies on the room map when the localization is right
    - Class: rviz/PointCloud2
      Name: LidarCloud
      Enabled: true
      Topic: /gimbalrotor/lio/cloud
      Style: Points
      Size (Pixels): 3
      Decay Time: 1
      Color Transformer: FlatColor
      Color: 255; 170; 50
      Queue Size: 2
    # the d435 cloud, made here from the compressed images (RVL depth, JPEG color); the robot only
    # compresses and sends them while this display is enabled
    - Class: rviz/DepthCloud
      Name: CameraCloud
      Enabled: true
      Depth Map Topic: /gimbalrotor/camera/aligned_depth_to_color/image_raw
      Depth Map Transport Hint: compressedDepth
      Color Image Topic: /gimbalrotor/camera/color/image_raw
      Color Transport Hint: compressed
      Queue Size: 5
      Style: Points
      Size (Pixels): 2
      Alpha: 1
      Occlusion Compensation: false
      Selectable: false
    - Class: rviz/TF
      Name: TF
      Enabled: false
  Global Options:
    Fixed Frame: map
    Background Color: 48; 48; 48
  Name: root
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    # drag on the robot to tell room_localization where it is, as in a 2D localization
    - Class: rviz/SetInitialPose
      Topic: /initialpose
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 8
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 0.8
      Yaw: 0.8
      Target Frame: gimbalrotor/root
# arm control panel on the left, flight teleop panel on the right
Window Geometry:
  Width: 1900
  Height: 1150
  QMainWindow State: 
