Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: gimbalrotor_remote/ArmControlPanel
    Name: ArmControlPanel
    Robot Namespace: gimbalrotor
    Arm Controller Namespace: arm/arm_controller
    Torque Service Namespace: arm_torque
  - Class: gimbalrotor_remote/FlightTeleopPanel
    Name: FlightTeleopPanel
    Robot Namespace: gimbalrotor
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
      Reference Frame: <Fixed Frame>
    - Class: rviz/RobotModel
      Name: RobotModel
      Enabled: true
      Robot Description: /gimbalrotor/robot_description
      TF Prefix: gimbalrotor
      Visual Enabled: true
      Collision Enabled: false
    # the d435 cloud, made here from the compressed images (RVL depth, JPEG color); the robot only
    # compresses and sends them while this display is enabled
    - Class: rviz/DepthCloud
      Name: CameraCloud
      Enabled: true
      Depth Map Topic: /gimbalrotor/camera/aligned_depth_to_color/image_raw
      Depth Map Transport Hint: compressedDepth
      Color Image Topic: /gimbalrotor/camera/color/image_raw
      Color Transport Hint: compressed
      Queue Size: 5
      Style: Points
      Size (Pixels): 2
      Alpha: 1
      Occlusion Compensation: false
      Selectable: false
    - Class: rviz/TF
      Name: TF
      Enabled: false
    # the fast_lio cloud, thinned on the robot (lio_cloud_rate of bringup, 2 Hz) and sent only while this
    # display is enabled
    - Class: rviz/PointCloud2
      Name: LidarCloud
      Enabled: true
      Topic: /gimbalrotor/lio/cloud
      Style: Points
      Size (Pixels): 3
      Decay Time: 1
      Color Transformer: FlatColor
      Color: 255; 170; 50
      Queue Size: 2
  Global Options:
    Fixed Frame: world
    Background Color: 48; 48; 48
  Name: root
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 2.5
      Focal Point:
        X: 0.3
        Y: 0
        Z: -0.1
      Pitch: 0.4
      Yaw: 2.4
      Target Frame: gimbalrotor/main_body
# arm control panel on the left, flight teleop panel on the right
Window Geometry:
  Width: 1900
  Height: 1150
  QMainWindow State: 
