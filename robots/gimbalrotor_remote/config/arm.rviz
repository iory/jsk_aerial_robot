Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: gimbalrotor_remote/ArmControlPanel
    Name: ArmControlPanel
    Robot Namespace: gimbalrotor
    Arm Controller Namespace: arm/arm_controller
    Torque Service Namespace: arm_torque
  - Class: gimbalrotor_remote/FlightTeleopPanel
    Name: FlightTeleopPanel
    Robot Namespace: gimbalrotor
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
      Reference Frame: <Fixed Frame>
    - Class: rviz/RobotModel
      Name: RobotModel
      Enabled: true
      Robot Description: /gimbalrotor/robot_description
      TF Prefix: gimbalrotor
      Visual Enabled: true
      Collision Enabled: false
    - Class: rviz/TF
      Name: TF
      Enabled: false
    # livox: roslaunch livox_ros_driver2 msg_MID360.launch xfer_format:=0 msg_frame_id:=gimbalrotor/lidar_imu
    - Class: rviz/PointCloud2
      Name: LivoxScan
      Enabled: true
      Topic: /livox/lidar
      Style: Points
      Size (Pixels): 2
      Decay Time: 0
      Color Transformer: AxisColor
      Axis: Z
      Queue Size: 2
      Unreliable: true
    # fast_lio map; needs a transform from the fixed frame to camera_init
    - Class: rviz/PointCloud2
      Name: FastLioMap
      Enabled: false
      Topic: /cloud_registered
      Style: Points
      Size (Pixels): 2
      Decay Time: 30
      Color Transformer: FlatColor
      Color: 200; 200; 200
      Queue Size: 2
  Global Options:
    Fixed Frame: world
    Background Color: 48; 48; 48
  Name: root
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 2.5
      Focal Point:
        X: 0.3
        Y: 0
        Z: -0.1
      Pitch: 0.4
      Yaw: 2.4
      Target Frame: gimbalrotor/main_body
# arm control panel on the left, flight teleop panel on the right
Window Geometry:
  Width: 1900
  Height: 1150
  QMainWindow State: 
