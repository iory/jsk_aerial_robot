<?xml version="1.0"?>
<package>
  <name>gimbalrotor_remote</name>
  <version>1.3.2</version>
  <description>Remote tools for gimbalrotor run on an operator PC: rviz with a panel to turn the arm servo torque on and off</description>

  <maintainer email="ab.ioryz@gmail.com">Iori Yanokura</maintainer>
  <license>BSD</license>
  <url type="website">https://github.com/jsk-ros-pkg/jsk_aerial_robot</url>

  <buildtool_depend>catkin</buildtool_depend>
  <build_depend>pluginlib</build_depend>
  <build_depend>qtbase5-dev</build_depend>
  <build_depend>roscpp</build_depend>
  <build_depend>rviz</build_depend>
  <build_depend>spinal</build_depend>
  <build_depend>std_srvs</build_depend>

  <run_depend>gimbalrotor</run_depend>
  <run_depend>libqt5-widgets</run_depend>
  <run_depend>pluginlib</run_depend>
  <run_depend>roscpp</run_depend>
  <run_depend>rviz</run_depend>
  <run_depend>spinal</run_depend>
  <run_depend>std_srvs</run_depend>

  <export>
    <rviz plugin="${prefix}/plugin_description.xml"/>
  </export>
</package>
