  <link name="fc">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.00001"/>
      <inertia
          ixx="0.000001" ixy="0.0" ixz="0.0"
          iyy="0.000001" iyz="0.0"
          izz="0.000001"/>
    </inertial>
  </link>

  <joint name="fc_joint" type="fixed">
    <child link="fc"/>
    <parent link="main_body"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="lidar_imu">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.00001"/>
      <inertia
          ixx="0.000001" ixy="0.0" ixz="0.0"
          iyy="0.000001" iyz="0.0"
          izz="0.000001"/>
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <child link="lidar_imu"/>
    <parent link="main_body"/>
    <origin xyz="0 0 -0.08" rpy="3.14159 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="main_body">
    <inertial>
      <!-- <origin xyz="-0.0041019 0.0000721 -0.0183334" rpy="0.0 -0.0 0.0"/> -->
      <origin xyz="0.0178508 0.0018366 -0.03525" rpy="0.0 -0.0 0.0"/>
      <!-- <mass value="1.3193189"/> -->
      <!-- <mass value="2.0421872">/ -->
      <mass value="1.8654999"/>
      <!-- <inertia ixx="0.0150906" ixy="-0.0000095" ixz="-0.0001112" iyy="0.0153469" iyz="-0.0000102" izz="0.0122100"/> -->
      <inertia
	  ixx="0.0233589"
	  ixy="-0.0000147"
	  ixz="-0.0001721"
	  iyy="0.0237556"
	  iyz="-0.0000158"
	  izz="0.0189000"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="package://gimbalrotor/urdf/grape_with_arm/meshes/main_body.dae"/>
      </geometry>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 -0.0 0.0"/>
    </visual>
    <collision>
      <geometry>
        <!-- <mesh filename="package://gimbalrotor/urdf/grape/meshes/main_body.stl"/> -->
        <!-- <box size="0.25 0.25 0.035"/> -->
	<box size="0.5 0.5 0.035"/>
      </geometry>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 -0.0 0.0"/>
    </collision>
    <!-- landing feet: pads at the bottom of the four legs of main_body.dae -->
    <xacro:property name="foot_size" value="0.032 0.072 0.028"/>
    <xacro:property name="foot_x" value="0.177"/>
    <xacro:property name="foot_y" value="0.200"/>
    <xacro:property name="foot_z" value="-0.304"/>
    <xacro:macro name="foot_collision" params="sx sy">
      <collision>
        <geometry>
          <box size="${foot_size}"/>
        </geometry>
        <origin xyz="${sx * foot_x} ${sy * foot_y} ${foot_z}" rpy="0.0 0.0 0.0"/>
      </collision>
    </xacro:macro>
    <xacro:foot_collision sx="1" sy="1"/>
    <xacro:foot_collision sx="1" sy="-1"/>
    <xacro:foot_collision sx="-1" sy="1"/>
    <xacro:foot_collision sx="-1" sy="-1"/>
  </link>

  <link name="gimbal1_link">
    <inertial>
      <origin xyz="0.0097185 -0.0000023 0.0115030" rpy="0.0 -0.0 0.0"/>
      <!-- <mass value="0.2647482"/> -->
      <mass value="0.308825311849623"/>
      <inertia ixx="0.0004342" ixy="0.0000000" ixz="-0.0000960" iyy="0.0005399" iyz="0.0000000" izz="0.0001644"/>
