<?xml version='1.0' encoding='UTF-8'?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="arm">
  <xacro:include filename="$(find gimbalrotor)/urdf/grape_with_arm/xacro/screw_yaw_module_dynamixel_side.xacro"/>
  <xacro:include filename="$(find gimbalrotor)/urdf/grape_with_arm/xacro/screw_90deg_module.xacro"/>
  <xacro:include filename="$(find gimbalrotor)/urdf/grape_with_arm/xacro/screw_200mmpipe_module.xacro"/>
  <xacro:include filename="$(find gimbalrotor)/urdf/grape_with_arm/xacro/screw_hinge_module_dynamixel.xacro"/>
  <xacro:include filename="$(find gimbalrotor)/urdf/grape_with_arm/xacro/screw_drive_module_dynamixel.xacro"/>
  <xacro:include filename="$(find gimbalrotor)/urdf/grape_with_arm/xacro/vial_pick_module.xacro"/>

  <!-- with_pipe: false for the arm cut after the 90deg module (the 200mm pipe and all that follows it
       taken off the real robot), so that the model keeps only joint1 and the 90deg module -->
  <xacro:macro name="arm" params="parent_link:=main_body xyz:='0.0995 0.0 -0.0465' rpy:='3.141592653589793 1.5707926535897934 3.141592653589793' with_pipe:=true">
    <!-- Dummy link to attach the arm to the main body -->
    <link name="arm_dummy_link"/>
    <joint name="arm_dummy_joint" type="fixed">
      <parent link="${parent_link}"/>
      <child link="arm_dummy_link"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>

    <!-- Joint 1: Yaw module -->
    <xacro:screw_yaw_module_dynamixel_side
      prefix="arm_joint1_"
      parent_link="arm_dummy_link"
      xyz="0 0 0"
      rpy="0 0 -1.5707963267948966"/>

    <!-- 90deg elbow module -->
    <xacro:screw_90deg_module
      prefix="arm_90deg_"
      parent_link="arm_joint1_dummy_link"
      xyz="0 0 0"
      rpy="0 3.14 -3.14159"/>

    <xacro:if value="${with_pipe}">
    <!-- 200mm pipe module -->
    <xacro:screw_200mmpipe_module
      prefix="arm_pipe_"
      parent_link="arm_90deg_dummy_link"
      xyz="0 0 0"
      rpy="0 0 0"/>

    <!-- Joint 2: Hinge module -->
    <xacro:screw_hinge_module_dynamixel
      prefix="arm_joint2_"
      parent_link="arm_pipe_dummy_link"
      xyz="0 0 0"
      rpy="0 0 0"/>

    <!-- Joint 3: Hinge module -->
    <xacro:screw_hinge_module_dynamixel
      prefix="arm_joint3_"
      parent_link="arm_joint2_dummy_link"
      xyz="0 0 0"
      rpy="0 3.14 -1.5707963267948966"/>

    <!-- Joint 4: Hinge module -->
    <xacro:screw_hinge_module_dynamixel
      prefix="arm_joint4_"
      parent_link="arm_joint3_dummy_link"
      xyz="0 0 0"
      rpy="0 3.14 0"/>

    <!-- <xacro:screw_hinge_module_dynamixel -->
    <!--   prefix="arm_joint5_" -->
    <!--   parent_link="arm_joint4_dummy_link" -->
    <!--   xyz="0 0 0" -->
    <!--   rpy="0 3.14 0"/> -->

    <!-- Joint 5: Drive module -->
    <xacro:screw_drive_module_dynamixel
	prefix="arm_joint5_"
      parent_link="arm_joint4_dummy_link"
      xyz="0 0 0"
      rpy="0 3.14 3.14"/>
    
    <!-- Gripper -->
    <xacro:vial_pick_module
      prefix="arm_gripper_"
      parent_link="arm_joint5_dummy_link"
      parent_joint="arm_joint5_joint1"
      xyz="0 0 0"
      rpy="0 0 0"/>
    </xacro:if>

    <!-- Transmissions for arm joints (required for Gazebo control) -->
    <transmission name="arm_joint1_tran">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="arm_joint1_joint1">
        <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
      </joint>
      <actuator name="arm_servo1">
        <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>

    <xacro:if value="${with_pipe}">
    <transmission name="arm_joint2_tran">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="arm_joint2_joint1">
        <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
      </joint>
      <actuator name="arm_servo2">
        <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>

    <transmission name="arm_joint3_tran">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="arm_joint3_joint1">
        <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
      </joint>
      <actuator name="arm_servo3">
        <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>

    <transmission name="arm_joint4_tran">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="arm_joint4_joint1">
        <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
      </joint>
      <actuator name="arm_servo4">
        <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>

    <transmission name="arm_joint5_tran">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="arm_joint5_joint1">
        <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
      </joint>
      <actuator name="arm_servo5">
        <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>
    </xacro:if>
  </xacro:macro>
</robot>
