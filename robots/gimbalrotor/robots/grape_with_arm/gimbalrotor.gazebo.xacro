<?xml version="1.0"?>
<robot
    xmlns:xacro="http://www.ros.org/wiki/xacro" name="gimbalrotor" >
  <xacro:arg name="robot_name" default="gimbalrotor" />

  <xacro:include filename="$(find gimbalrotor)/robots/grape_with_arm/gimbalrotor.urdf.xacro" />

  <!-- gazebo plugin for default controller and sensors -->
  <xacro:include filename="$(find aerial_robot_simulation)/xacro/spinal.gazebo.xacro" />
  <xacro:gazebo_spinal robot_name="$(arg robot_name)" mag_frame="fc" />

  <xacro:rotor_transmission id="1"/>
  <xacro:rotor_transmission id="2"/>
  <xacro:rotor_transmission id="3"/>
  <xacro:rotor_transmission id="4"/>

  <xacro:joint_transmission joint="gimbal1"/>
  <xacro:joint_transmission joint="gimbal2"/>
  <xacro:joint_transmission joint="gimbal3"/>
  <xacro:joint_transmission joint="gimbal4"/>

  <!-- the gripper joints follow arm_joint5_joint1 through <mimic>, which gazebo classic ignores -->
  <gazebo>
    <plugin name="mimic_joint_plugin" filename="libaerial_robot_mimic_joint_plugin.so">
      <robotNamespace>$(arg robot_name)</robotNamespace>
    </plugin>
  </gazebo>

  <!-- The feet of main_body: without contact parameters the robot creeps over the ground while it
       stands there (the arm servos jitter and the contact bounces), which moves the field frame of
       the demo away from the world. Stiff contact with no bounce keeps it where it is put. -->
  <gazebo reference="main_body">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <maxVel>0.0</maxVel>
    <minDepth>0.001</minDepth>
  </gazebo>

  <!-- realsense d435: the same topics and frames as realsense2_camera on the real machine,
       <robot_ns>/camera/color/image_raw and <robot_ns>/camera_color_optical_frame.
       The image is an ideal pinhole camera: no lens distortion, no depth noise, and the
       resolution and the field of view are those of the color stream at 640x480.
       Rendering a frame costs far more than the physics: on a machine without a GPU for gazebo,
       the images arrived at 1.3 Hz instead of 30 Hz (the physics kept running at real time).
       Lower camera_fps / camera_width / camera_height there. -->
  <xacro:arg name="camera_fps" default="30.0"/>
  <xacro:arg name="camera_width" default="640"/>
  <xacro:arg name="camera_height" default="480"/>
  <gazebo reference="camera_link">
    <sensor name="camera" type="depth">
      <always_on>1</always_on>
      <update_rate>$(arg camera_fps)</update_rate>
      <!-- the color sensor of the d435, 15 mm left of the tripod mount axis -->
      <pose>0 0.015 0 0 0 0</pose>
      <camera>
        <horizontal_fov>1.211</horizontal_fov>
        <image>
          <width>$(arg camera_width)</width>
          <height>$(arg camera_height)</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>10.0</far>
        </clip>
      </camera>
      <plugin name="camera_controller" filename="libgazebo_ros_openni_kinect.so">
        <robotNamespace>$(arg robot_name)</robotNamespace>
        <cameraName>camera</cameraName>
        <alwaysOn>true</alwaysOn>
        <updateRate>$(arg camera_fps)</updateRate>
        <imageTopicName>color/image_raw</imageTopicName>
        <cameraInfoTopicName>color/camera_info</cameraInfoTopicName>
        <depthImageTopicName>aligned_depth_to_color/image_raw</depthImageTopicName>
        <depthImageCameraInfoTopicName>aligned_depth_to_color/camera_info</depthImageCameraInfoTopicName>
        <pointCloudTopicName>depth/color/points</pointCloudTopicName>
        <frameName>$(arg robot_name)/camera_color_optical_frame</frameName>
        <!-- the d435 sees from 0.2 m (min-z of the depth stream) -->
        <pointCloudCutoff>0.2</pointCloudCutoff>
        <pointCloudCutoffMax>10.0</pointCloudCutoffMax>
        <baseline>0.05</baseline>
        <distortionK1>0</distortionK1>
        <distortionK2>0</distortionK2>
        <distortionK3>0</distortionK3>
        <distortionT1>0</distortionT1>
        <distortionT2>0</distortionT2>
      </plugin>
    </sensor>
  </gazebo>

</robot>
