<?xml version="1.0"?>
<!--
  Match the cloud of this run against a map recorded once and publish map -> camera_init, so that the
  coordinates of a place are the same on every run. fast_lio (and the lidar driver it needs) must already
  be running; the map is a PCD of the same place, e.g. the scans.pcd fast_lio writes with
  pcd_save/pcd_save_en.

    roslaunch gimbalrotor room_localization.launch map:=/path/to/scans.pcd
-->
<launch>
  <arg name="map" />
  <arg name="cloud" default="/cloud_registered" />
  <arg name="map_frame" default="map" />
  <arg name="odom_frame" default="camera_init" />
  <arg name="duration" default="5.0" />
  <!-- heading the robot had when the map was recorded, seen from this run [rad] -->
  <arg name="yaw_hint" default="0.0" />

  <node pkg="gimbalrotor" type="room_localization.py" name="room_localization" output="screen">
    <param name="map" value="$(arg map)" />
    <param name="cloud" value="$(arg cloud)" />
    <param name="map_frame" value="$(arg map_frame)" />
    <param name="odom_frame" value="$(arg odom_frame)" />
    <param name="duration" value="$(arg duration)" />
    <param name="yaw_hint" value="$(arg yaw_hint)" />
  </node>
</launch>
