<?xml version="1.0"?>
<launch>
  ###########  launch config  ###########
  <arg name="rm" default="True" />
  <arg name="sim" default="False" />
  <arg name="real_machine" default="$(arg rm)" />
  <arg name="simulation" default="$(arg sim)" />
  <arg name="control_mode" default="0" />
  <arg name="estimate_mode"  default= "1" />
  <arg name="sim_estimate_mode"  default= "2" />
  <arg name="headless" default="True" />
  <arg name="worldtype" default="$(find aerial_robot_simulation)/gazebo_model/world/empty.world" />
  <arg name="launch_gazebo" default="True" />
  <arg name="direct_model" default="False" />
  <arg name="direct_model_name" />
  <arg name="spawn_x" default="0.0"/>
  <arg name="spawn_y" default="0.0"/>
  <arg name="spawn_yaw" default="0.0"/>
  <arg name="config_dir" default="$(find gimbalrotor)/config"/>
  <arg name="robot_id" default="" />
  <!-- xacro arguments of the robot model, given from another launch file (roslaunch takes no ':=' in the
       value of a command line argument) -->
  <arg name="model_options" default="" />
  <arg name="robot_ns" value="gimbalrotor$(arg robot_id)" />
  <arg name="airframe" default="quad" />
  <!-- grape_with_arm stands on legs reaching 0.318 m below the body; spawning lower buries the feet and flips it -->
  <arg name="spawn_z" default="$(eval 0.33 if arg('airframe') == 'grape_with_arm' else 0.0)"/>
  <!-- grape_with_arm with its arm cut after the 90deg module (the 200mm pipe and all that follows it taken
       off): the robot model keeps joint1 and the 90deg module only, and the arm controller, which needs
       all the joints, is not started -->
  <arg name="arm_pipe" default="true" />
  <arg name="takeoff_height" default="" />
  <!-- gazebo: the rotor and gimbal servo delays of the real machine (config/<airframe>/SimulationActuatorDelay.yaml) -->
  <arg name="sim_actuator_delay" default="false" />
  <!-- gazebo with the control config of the real machine (GimbalrotorControl.yaml) instead of the _sim one -->
  <arg name="sim_real_control_config" default="false" />
  <arg name="sim_actuator_delay_file" default="$(arg config_dir)/$(arg airframe)/SimulationActuatorDelay.yaml" />
  <!-- gazebo: "ixx,iyy,izz" (or with spaces) [kg m2] added to the body of the spawned robot (grape_with_arm), e.g. the inertia
       measured in flight, while the controller keeps the robot model -->
  <arg name="sim_body_extra_inertia" default="" />
  <!-- true / false: re-allocate the thrusts on the measured gimbal angles (controller/gimbal_lag_compensation);
       empty keeps the control config -->
  <arg name="gimbal_lag_compensation" default="" />
  <arg name="launch_arm_controller" default="$(eval arg('airframe') == 'grape_with_arm' and arg('arm_pipe'))" />
  <arg name="arm_control_rate" default="20.0" />
  <!-- realsense d435 (grape_with_arm); the camera frames are in urdf/grape_with_arm/gimbalrotor.urdf.xacro -->
  <arg name="camera" default="$(eval arg('airframe') == 'grape_with_arm')" />
  <!-- livox mid360 and fast_lio (real machine): the position of estimate_mode 0 -->
  <arg name="lidar" default="$(eval int(arg('estimate_mode')) == 0)" />
  <!-- a map (pcd) of the room for script/room_localization.py: a path, or the name of a map in maps/
       (e.g. room_20260916); empty to run without it -->
  <arg name="room_map" default="" />
  <arg name="room_yaw_hint" default="0.0" />
  <!-- grape_detector on the d435 (real machine, grape_with_arm); gazebo runs it on its own, see
       grape_harvest_sim.launch -->
  <arg name="grape_detection" default="$(eval arg('airframe') == 'grape_with_arm')" />
  <!-- record the flight on the onboard PC (real machine), see launch/include/record.launch.xml -->
  <arg name="rosbag" default="false" />
  <arg name="rosbag_prefix" default="$(env HOME)/.ros/gimbalrotor$(arg robot_id)" />

  ###########  Parameters  ###########
  <group ns="$(arg robot_ns)">
    # EGOMOTION_ESTIMATE = 0
    # EXPERIMENT_ESTIMATE = 1. for unstable mocap, use this mode
    # GROUND_TRUTH = 2

    ###########  Basic Param  ###########
    <param name="estimation/mode" value= "$(arg sim_estimate_mode)" if="$(arg simulation)" />
    <param name="estimation/mode" value= "$(arg estimate_mode)" if="$(arg real_machine)"/>

   ###########  Robot Model  ###########
   <rosparam file="$(arg config_dir)/RobotModel.yaml" command="load" />

   ###########  Motor Config  ###########
   <rosparam file="$(arg config_dir)/MotorInfo.yaml" command="load" />

   ###########  Servo Config  ###########
   <rosparam file="$(arg config_dir)/$(arg airframe)/Servo.yaml" command="load"/>
   
   ###########  Battery Config  ###########
   <rosparam file="$(arg config_dir)/Battery.yaml" command="load" />

   ###########  Control  ###########
   <rosparam file="$(arg config_dir)/$(arg airframe)/GimbalrotorControl.yaml" command="load"
             if="$(eval not arg('simulation') or arg('sim_real_control_config'))"/>
   <rosparam file="$(arg config_dir)/$(arg airframe)/GimbalrotorControl_sim.yaml" command="load"
             if="$(eval arg('simulation') and not arg('sim_real_control_config'))"/>
   <param if="$(eval arg('gimbal_lag_compensation') != '')" name="controller/gimbal_lag_compensation"
          value="$(arg gimbal_lag_compensation)" />
   <rosparam if="$(eval arg('simulation') and arg('sim_actuator_delay'))"
             file="$(arg sim_actuator_delay_file)" command="load" />

   ###########  Sensor Fusion  ###########
   <rosparam file="$(arg config_dir)/StateEstimation.yaml" command="load" />
   <rosparam file="$(arg config_dir)/Simulation.yaml" command="load" if="$(eval arg('simulation') and not arg('real_machine'))"/>

   ###########  Navigation  ###########
   <param name="flight_navigation_plugin_name" value="aerial_robot_navigation/gimbalrotor_navigation" />
   <rosparam file="$(arg config_dir)/NavigationConfig.yaml" command="load" />
   <!-- takeoff_height:=<m> replaces the takeoff height of NavigationConfig.yaml (above the height at arming on
        the real machine with the lidar) -->
   <param if="$(eval arg('takeoff_height') != '')" name="navigation/takeoff_height" value="$(arg takeoff_height)" />

  </group>

  ###########  Base Platform  ###########
  <node pkg="aerial_robot_base" type="aerial_robot_base_node" name="aerial_robot_base_node" ns="$(arg robot_ns)" output="screen" >
    <param name="tf_prefix" value="$(arg robot_ns)"/>
    <param name="param_verbose" value="false"/>
    <param name="main_rate" value="200"/>
  </node>

  ###########  Robot Model  ###########
  <arg name="description_mode" value="urdf" unless="$(arg simulation)" />
  <arg name="description_mode" value="gazebo" if="$(arg simulation)" />
  <include file="$(find aerial_robot_model)/launch/aerial_robot_model.launch" >
    <arg name="headless" value="$(arg headless)" />
    <arg name="robot_model" value="$(find gimbalrotor)/robots/$(arg airframe)/gimbalrotor.$(arg description_mode).xacro"/>
    <arg name="model_options" value="$(eval arg('model_options') + (' arm_pipe:=' + str(arg('arm_pipe')).lower() if arg('airframe') == 'grape_with_arm' else ''))" />
    <arg name="robot_ns" value="$(arg robot_ns)" />
    <arg name="rviz_config" value="$(arg config_dir)/rviz_config" />
    <arg name="rviz_init_pose" value="$(arg config_dir)/RvizInit.yaml" />
    <arg name="need_joint_state" value="false" if ="$(eval arg('simulation') or arg('real_machine'))"/>
  </include >

  ##########  Sensors  ##########
  <include file="$(find gimbalrotor)/launch/include/sensors.launch.xml" >
    <arg name="real_machine" value="$(arg real_machine)" />
    <arg name="simulation" value="$(arg simulation)" />
    <arg name="robot_ns" value="$(arg robot_ns)" />
    <arg name="camera" value="$(arg camera)" />
    <arg name="lidar" value="$(arg lidar)" />
    <arg name="room_map" value="$(arg room_map)" />
    <arg name="room_yaw_hint" value="$(arg room_yaw_hint)" />
  </include >

  ##########  Flight record  ##########
  <include file="$(find gimbalrotor)/launch/include/record.launch.xml"
           if="$(eval arg('real_machine') and not arg('simulation') and arg('rosbag'))">
    <arg name="robot_ns" value="$(arg robot_ns)" />
    <arg name="prefix" value="$(arg rosbag_prefix)" />
  </include>

  ##########  Grape detection  ##########
  <include file="$(find grape_detector)/launch/grape_detection.launch"
           if="$(eval arg('real_machine') and not arg('simulation') and arg('camera') and arg('grape_detection'))">
    <arg name="robot_ns" value="$(arg robot_ns)" />
  </include>

  ###########  Servo Bridge  ###########
  <node pkg="aerial_robot_model" type="servo_bridge_node" name="servo_bridge" ns="$(arg robot_ns)" output="screen"/>
  <!-- gazebo: servo/torque_enable and servo/torque_states of spinal -->
  <node pkg="gimbalrotor" type="servo_torque_sim.py" name="servo_torque_sim" ns="$(arg robot_ns)" output="screen"
        if="$(eval arg('simulation') and not arg('real_machine'))" />

  ########## Simulation in Gazebo #########
  <arg name="gazebo_model_options" value="$(eval arg('model_options') + (' arm_pipe:=' + str(arg('arm_pipe')).lower() if arg('airframe') == 'grape_with_arm' else '') + ''.join(' body_extra_%s:=%s' % (k, v) for k, v in zip(('ixx', 'iyy', 'izz'), (arg('sim_body_extra_inertia').replace(',', ' ').split() + ['0', '0', '0'])[:3])))" />
  <param if="$(eval arg('simulation') and not arg('real_machine') and arg('sim_body_extra_inertia') != '')"
         name="$(arg robot_ns)/robot_description_gazebo"
         command="$(find xacro)/xacro '$(find gimbalrotor)/robots/$(arg airframe)/gimbalrotor.$(arg description_mode).xacro' robot_name:=$(arg robot_ns) $(arg gazebo_model_options)" />
  <include file="$(find aerial_robot_simulation)/launch/gazebo.launch" if = "$(eval arg('simulation') and not arg('real_machine'))" >
    <arg name="robot_ns" default="$(arg robot_ns)" />
    <arg name="gui" default="false" if="$(arg headless)"/>
    <arg name="headless" default="$(arg headless)" />
    <arg name="launch_gazebo" default="$(arg launch_gazebo)" />
    <arg name="worldtype" value="$(arg worldtype)" />
    <arg name="spawn_x" value="$(arg spawn_x)" />
    <arg name="spawn_y" value="$(arg spawn_y)" />
    <arg name="spawn_z" value="$(arg spawn_z)" />
    <arg name="spawn_yaw" value="$(arg spawn_yaw)" />
    <arg name="description_param" value="$(eval arg('robot_ns') + '/robot_description' + ('_gazebo' if arg('sim_body_extra_inertia') != '' else ''))" />
  </include>

  ########## Manipulator (ros_control: FollowJointTrajectory) #########
  <group if="$(arg launch_arm_controller)">
    <rosparam file="$(arg config_dir)/$(arg airframe)/ArmController.yaml" command="load" ns="$(arg robot_ns)/arm" />
    <node pkg="gimbalrotor" type="arm_hardware_interface_node" name="arm_hardware_interface" ns="$(arg robot_ns)" output="screen">
      <param name="controller_ns" value="arm" />
      <param name="control_rate" value="$(arg arm_control_rate)" />
      <param name="servo_group" value="joints" />
    </node>
    <node pkg="controller_manager" type="spawner" name="arm_controller_spawner" ns="$(arg robot_ns)/arm" output="screen" args="arm_controller" unless="$(arg simulation)" />
    <!-- simulation: the arm falls until servo_bridge loads its joint controllers, and the trajectory controller
         holds the pose it starts in, so start it only after the arm has settled at the servo init_value -->
    <group if="$(arg simulation)">
      <node pkg="gimbalrotor" type="arm_initial_pose_gate.py" name="arm_initial_pose_gate" ns="$(arg robot_ns)" output="screen">
        <param name="servo_group" value="joints" />
      </node>
      <node pkg="controller_manager" type="spawner" name="arm_controller_spawner" ns="$(arg robot_ns)/arm" output="screen"
            args="--wait-for /$(arg robot_ns)/arm_initial_pose_gate/ready arm_controller" />
    </group>
  </group>

</launch>
