<?xml version="1.0"?>
<launch>
  <arg name="real_machine" default="false" />
  <arg name="simulation" default="false" />
  <arg name="robot_ns" default="gimbalrotor" />
  <arg name="camera" default="false" />
  <!-- livox mid360 and fast_lio, the position of the state estimation with estimate_mode 0 -->
  <arg name="lidar" default="false" />
  <!-- a map (pcd) of the room for room_localization.py; empty to run without it -->
  <arg name="room_map" default="" />
  <arg name="room_yaw_hint" default="0.0" />
  <!-- rate of the lidar odometry cloud sent to the operator PC [Hz]; fast_lio publishes 10 Hz, 1.6 MB/s -->
  <arg name="lio_cloud_rate" default="2.0" />

  <group ns="$(arg robot_ns)">

    <group if="$(arg real_machine)">
      <group unless="$(arg simulation)">

        <!-- fc & IMU & GPS -->
        <include file="$(find spinal)/launch/bridge.launch" >
          <arg name="mode" value="serial" />
          <arg name="serial_port" value="/dev/flight_controller" />
          <arg name="serial_baud" value="921600" />
        </include>

        <!-- realsense d435 -->
        <!-- The camera frames come from the URDF (robot_state_publisher), as in gazebo, so that the
             topics and the frames are the same in both; the driver publishes no tf of its own.
             tf_prefix names the frames <robot_ns>/camera_*, which is what the URDF publishes. -->
        <include file="$(find realsense2_camera)/launch/rs_camera.launch" if="$(arg camera)">
          <arg name="tf_prefix" value="$(arg robot_ns)/camera" />
          <arg name="publish_tf" value="false" />
          <arg name="align_depth" value="true" />
          <!-- the cloud is made on the operator PC from the compressed images, see gimbalrotor_remote -->
          <arg name="enable_pointcloud" value="false" />
          <arg name="color_width" value="640" />
          <arg name="color_height" value="480" />
          <arg name="color_fps" value="30" />
          <arg name="depth_width" value="640" />
          <arg name="depth_height" value="480" />
          <arg name="depth_fps" value="30" />
        </include>

        <!-- the lidar odometry cloud for the operator PC, thinned to lio_cloud_rate. lazy: it subscribes
             only while someone watches, and it copies the messages without decoding them -->
        <node pkg="topic_tools" type="throttle" name="lio_cloud_throttle"
              args="messages cloud_registered $(arg lio_cloud_rate) lio/cloud">
          <param name="lazy" value="true" />
        </node>

        <!-- mocap -->
        <include file="$(find aerial_robot_base)/launch/external_module/mocap.launch" />

        <!-- livox mid360 & fast lio, in the namespace of the robot as for dragon: fast_lio publishes
             Odometry_precede there, which sensor_plugin/vo of the state estimation subscribes to
             (config/sensors/lio/livox_mid360.yaml of aerial_robot_base). fast_lio uses the IMU of the
             MID360 (livox/imu); the pipeline that fed it the IMU of spinal needs imu_transformer. -->
        <group if="$(arg lidar)">
          <include file="$(find livox_ros_driver2)/launch_ROS1/msg_MID360.launch" />
          <include file="$(find fast_lio)/launch/mapping_mid360.launch" >
            <arg name="rviz" value="false" />
          </include>
        </group>

      </group>
    </group>

    <!-- compressed images for the operator PC. A transport only encodes while something subscribes to it.
         Depth: RVL is lossless like PNG and about 5x cheaper on the onboard CPU (3.7 vs 20.5 ms for a
         640x480 frame on the Khadas VIM4), for about 2x the size (190 vs 90 KB). Color: JPEG. -->
    <param name="camera/aligned_depth_to_color/image_raw/compressedDepth/format" value="rvl" />
    <param name="camera/color/image_raw/compressed/format" value="jpeg" />
    <param name="camera/color/image_raw/compressed/jpeg_quality" value="60" />

    <!-- basic configuration for sensors (e.g. noise sigma) -->
    <rosparam file="$(find gimbalrotor)/config/sensors/imu/spinal.yaml" command="load" />
    <rosparam file="$(find aerial_robot_base)/config/sensors/mocap.yaml" command="load" />
    <rosparam file="$(find aerial_robot_base)/config/sensors/lio/livox_mid360.yaml" command="load" />

  </group>

  <!-- the same coordinates on every run: map -> camera_init and map -> world. Outside the namespace
       of the robot, where config/room.rviz of gimbalrotor_remote looks for its map. -->
  <group if="$(eval arg('real_machine') and not arg('simulation') and arg('lidar') and arg('room_map') != '')">
    <include file="$(find gimbalrotor)/launch/room_localization.launch">
      <arg name="map" value="$(arg room_map)" />
      <arg name="yaw_hint" value="$(arg room_yaw_hint)" />
      <arg name="robot_ns" value="$(arg robot_ns)" />
      <arg name="cloud" value="/$(arg robot_ns)/cloud_registered" />
      <arg name="lio_odom" value="/$(arg robot_ns)/Odometry" />
    </include>
  </group>

</launch>
